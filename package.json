{
  "name": "my-chat",
  "version": "0.0.0",
  "description": "Chat app made for educational purposes",
  "homepage": "https://github.com/abdelrahmanmohamed-web/my-chat#readme",
  "bugs": {
    "url": "https://github.com/abdelrahmanmohamed-web/my-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelrahmanmohamed-web/my-chat.git"
  },
  "license": "ISC",
  "author": "AbdElrhman",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n FRONT,BACK \"npm:dev:front\" \"npm:dev:back\"",
    "dev:front": "npm run dev --workspace=@my-app/frontend",
    "dev:back": "npm run dev --workspace=@my-app/backend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "check": "npm run lint && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md}": "prettier --write"
  }
}
