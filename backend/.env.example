# ==============================================================================
# Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env.secrets' (or '.env') and supply real values.
# Do NOT commit sensitive keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Port on which the Express server listens
PORT=3000

# Client origin allowed by CORS and Socket.IO
FRONTEND_URL=http://localhost:5173

# Logging level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace' | 'silent'
LOG_LEVEL=info

# Number of reverse proxies (e.g. Nginx, Cloudflare) in front of the server (optional)
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Database Connection (Secrets)
# ------------------------------------------------------------------------------
# MongoDB connection string (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/chat_app

# ------------------------------------------------------------------------------
# 3. Authentication & JWT Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
# Cryptographically secure random keys of at least 32 bytes/characters.
# You can generate them using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OR
#   openssl rand -base64 32

# Secret used to sign short-lived access tokens (min 32 bytes)
ACCESS_TOKEN_SECRET=your_super_secret_access_token_key_min_32_characters_here

# Secret used to sign refresh tokens (min 32 bytes, MUST differ from ACCESS_TOKEN_SECRET)
REFRESH_TOKEN_SECRET=your_super_secret_refresh_token_key_min_32_characters_here

# JWT metadata claims
JWT_ISSUER=my-chat-api
JWT_AUDIENCE=my-chat-clients

# Token Lifespans (in seconds)
# Access token lifespan (default: 840 seconds = 14 minutes)
ACCESS_TTL=840

# Refresh token lifespan (default: 1209600 seconds = 14 days)
REFRESH_TTL_SECONDS=1209600

# ------------------------------------------------------------------------------
# 4. Security & Rate Limiting (Requests per 15-minute window)
# ------------------------------------------------------------------------------
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30
